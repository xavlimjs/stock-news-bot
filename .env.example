# Copy this file to ".env" and fill in your real values. Never commit ".env".

# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_key_here

# Optional secondary source. Get a free key at https://newsapi.org/register
NEWSAPI_API_KEY=your_newsapi_key_here

# Create a bot via @BotFather on Telegram, it will give you a token like:
# 123456789:AAExampleTokenStringHere
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The chat ID that should receive alerts. For a personal DM, message your bot
# once then run: python get_chat_id.py  (included in this project) to find it.
TELEGRAM_CHAT_ID=your_chat_id_here
